# ============================================================
# FinGuard - Nível 1 - Variáveis de ambiente
# Copie para .env e preencha as credenciais AWS antes de subir.
# ============================================================

# ---- AWS Bedrock ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Modelo de inferência (sugestão: Haiku para custo baixo)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Modelo de embeddings para o RAG (Titan v2: 1024 dim, normalizado)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# Diretório de saída dentro do container (mount: ./output)
OUTPUT_DIR=/app/output

# ---- RAG ----
# Pasta com os documentos de política (PDF/MD/TXT)
RAG_DOCS_DIR=/app/assets/docs
# Pasta onde o índice FAISS + manifest são persistidos
RAG_INDEX_DIR=/app/assets/index
# Quando true, o classificador injeta top-K trechos da política como contexto
RAG_ENABLED=false
RAG_TOP_K=3
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=200
