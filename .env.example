# ============================================================
# FinGuard - Nível 2 - Variáveis de ambiente
# Copie para .env e preencha as credenciais AWS antes de subir.
# ============================================================

# ---- AWS Bedrock ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Combinação estratégica de modelos (otimização de custo):
# - Triagem: Claude Haiku (barato, classificação simples)
# - Risco:   Claude Sonnet (raciocínio sobre política, detecção de fraude/LGPD)
BEDROCK_MODEL_TRIAGE=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_RISK=anthropic.claude-3-5-sonnet-20241022-v2:0

# Caminho do documento de Política Interna usado pelo agente de risco (RAG)
POLICY_PATH=/app/data/politica_interna.md

# Diretório de saída dentro do container (mount: ./output)
OUTPUT_DIR=/app/output
