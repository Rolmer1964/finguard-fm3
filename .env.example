# ============================================================
# FinGuard - Variáveis de ambiente
# Copie para .env e ajuste antes do primeiro `docker compose up`.
# ============================================================

# ---- Admin inicial (seed do auth_service na 1ª subida) ----
ADMIN_EMAIL=admin@finguard.local
ADMIN_PASSWORD=Troque@123
ADMIN_NAME=Administrador

# ---- JWT ----
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_ALG=HS256
JWT_EXP_HOURS=24

# ---- PostgreSQL ----
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard
POSTGRES_DB=finguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- AWS Bedrock ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Modelos (ajuste IDs conforme disponibilidade na sua conta/região)
BEDROCK_MODEL_TRIAGE=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_RISK=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_REPORT=anthropic.claude-3-haiku-20240307-v1:0

# Guardrail (criar previamente no console e colar IDs aqui)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ---- URLs internas (rede do compose) ----
AUTH_SERVICE_URL=http://auth_service:8001
COMPLAINT_SERVICE_URL=http://complaint_service:8002
ORCHESTRATOR_URL=http://agent_orchestrator:8003
REPORT_SERVICE_URL=http://report_service:8004

# ---- Frontend ----
# URL do gateway exposta para o navegador
VITE_API_BASE_URL=http://localhost:8000
