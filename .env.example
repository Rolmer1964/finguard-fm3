# ============================================================
# FinGuard - Nível 3 - Variáveis de ambiente
# Copie para .env e preencha as credenciais AWS antes de subir.
# ============================================================

# ---- AWS Bedrock ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Combinação estratégica de modelos (otimização de custo):
# - Triagem: Claude Haiku (barato, classificação simples)
# - Risco:   Claude Sonnet (raciocínio sobre política, detecção de fraude/LGPD)
BEDROCK_MODEL_TRIAGE=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_RISK=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Embeddings para o RAG (Titan v2: 1024 dim, normalizado)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# Diretório de saída dentro do container (mount: ./output)
OUTPUT_DIR=/app/output

# ---- RAG ----
# Pasta com documentos de política (PDF/MD/TXT)
RAG_DOCS_DIR=/app/assets/docs
# Pasta onde o índice FAISS + manifest são persistidos
RAG_INDEX_DIR=/app/assets/index
# Quantos trechos top-K injetar no prompt do agente de risco
RAG_TOP_K=4
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=200

# ---- Bedrock Guardrails (Nível 3) ----
# Provisione com: python scripts/create_guardrail.py --region us-east-1
# Deixe vazio para usar fallback local (heurístico)
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# ---- Batch paralelo ----
BATCH_MAX_WORKERS=10
BATCH_RATE_LIMIT_DELAY=0.0
BATCH_MAX_RETRIES=2
