<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bordo-900:#3a0d1f; --bordo-800:#551227; --bordo-700:#7a1a35; --bordo-600:#93213f;
    --bordo-500:#b02c50; --bordo-400:#c94a6b; --bordo-100:#f6e2e8; --bordo-50:#fbf1f4;
    --gold:#b8893f; --gold-dark:#8f6a2c;
    --bg:#f6eef0; --card:#fffdfd; --text:#2b1017; --muted:#8a6270; --border:#ecd9df;
  }
  * { box-sizing:border-box; }
  body.app {
    font-family:'Inter',-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    background:var(--bg); color:var(--text); margin:0; padding:0;
  }
  .app h1, .app h2, .app h3 { font-family:'Playfair Display',Georgia,serif; color:var(--bordo-900); }
  .app-topbar {
    background:linear-gradient(135deg,var(--bordo-800),var(--bordo-700));
    color:#fdf1f4; padding:16px 28px; display:flex; justify-content:space-between;
    align-items:center; flex-wrap:wrap; gap:10px; box-shadow:0 2px 10px rgba(58,13,31,.25);
  }
  .app-topbar a.brand { color:#fdf1f4; font-family:'Playfair Display',Georgia,serif; font-weight:700;
    font-size:19px; text-decoration:none; letter-spacing:.02em; }
  .app-nav { display:flex; gap:6px; flex-wrap:wrap; }
  .app-topbar .app-nav a { padding:7px 14px; border-radius:999px; font-size:12.5px; font-weight:600; text-decoration:none;
    color:#f6dbe3; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); transition:.15s; }
  .app-topbar .app-nav a:hover { background:rgba(255,255,255,.18); color:#f6dbe3; }
  .app-nav a.active { background:var(--gold); color:#2b1017; border-color:var(--gold); }
  .app-body { max-width:1120px; margin:0 auto; padding:28px 20px 60px; }
  .app .muted { color:var(--muted); font-size:13px; }
  .app .card { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:20px;
    box-shadow:0 2px 10px rgba(122,26,53,.06); margin-top:16px; }
  .app label { display:block; font-size:13px; font-weight:600; margin-top:12px; color:var(--bordo-800); }
  .app input, .app textarea, .app select { width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px;
    font-family:inherit; font-size:14px; box-sizing:border-box; background:#fffafb; color:var(--text); }
  .app input:focus, .app textarea:focus, .app select:focus { outline:none; border-color:var(--bordo-500); box-shadow:0 0 0 3px var(--bordo-100); }
  .app button, .app .btn { margin-top:16px; padding:10px 22px; background:var(--bordo-700); color:#fff;
    border:none; border-radius:8px; cursor:pointer; font-weight:600; font-size:14px; text-decoration:none;
    display:inline-block; transition:background .15s; }
  .app button:hover, .app .btn:hover { background:var(--bordo-800); }
  .app .btn-gold { background:var(--gold); color:#2b1017; }
  .app .btn-gold:hover { background:var(--gold-dark); color:#fff; }
  .app .btn-outline { background:transparent; color:var(--bordo-700); border:1px solid var(--bordo-500); }
  .app .btn-outline:hover { background:var(--bordo-50); }
  .app .btn-danger { background:#8a2331; }
  .app .btn-danger:hover { background:#6e1a26; }
  .app .btn-ghost { background:none; border:1px solid var(--border); color:var(--muted); }
  .app .btn-ghost:hover { background:var(--bordo-50); }
  .app pre { background:var(--bordo-50); border:1px solid var(--border); padding:12px; border-radius:8px;
    overflow-x:auto; font-size:13px; }
  .app code { background:var(--bordo-50); padding:1px 6px; border-radius:4px; }
  .app table { width:100%; border-collapse:collapse; background:var(--card); border-radius:10px;
    overflow:hidden; box-shadow:0 2px 10px rgba(122,26,53,.06); }
  .app th { background:var(--bordo-700); color:#fdf1f4; padding:10px 12px; text-align:left; font-size:11.5px;
    text-transform:uppercase; letter-spacing:.05em; white-space:nowrap; }
  .app td { padding:10px 12px; border-bottom:1px solid var(--border); vertical-align:middle; font-size:13px; }
  .app tr:last-child td { border-bottom:none; }
  .app tr:hover td { background:var(--bordo-50); }
  .app a { color:var(--bordo-600); }
  .app a:hover { color:var(--bordo-800); }
  .app .pill { padding:2px 10px; border-radius:999px; font-size:11px; font-weight:700; }
  .app .pill.crit  { background:#f6d9de; color:#7a1a2b; }
  .app .pill.alta  { background:#f7e3d0; color:#8a4a12; }
  .app .pill.media { background:#faf0cf; color:#7a5f0c; }
  .app .pill.baixa { background:#dcefe0; color:#1f5c34; }
  .app .kpi-card { text-align:center; }
  .app .kpi-card .v { font-size:32px; font-weight:700; font-family:'Playfair Display',Georgia,serif; color:var(--bordo-800); }
  .app .kpi-card .l { color:var(--muted); font-size:13px; margin-top:2px; }
  .app .section-title { font-size:16px; font-weight:700; margin:32px 0 12px; padding-bottom:6px;
    border-bottom:2px solid var(--bordo-500); font-family:'Playfair Display',Georgia,serif; color:var(--bordo-900); }
</style>
