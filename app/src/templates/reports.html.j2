<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Relatórios — FinGuard</title>
<style>
  body { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
         max-width:900px; margin:32px auto; padding:0 16px; color:#1f2937; background:#f9fafb; }
  h1 { margin-bottom:4px; }
  .muted { color:#6b7280; font-size:13px; margin-bottom:16px; display:block; }
  table { width:100%; border-collapse:collapse; background:white; border-radius:8px;
          overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.08); }
  th { background:#1e40af; color:white; padding:10px 14px; text-align:left;
       font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
  td { padding:10px 14px; border-bottom:1px solid #e5e7eb; vertical-align:middle; }
  tr:last-child td { border-bottom:none; }
  tr:hover td { background:#f0f9ff; }
  a { color:#2563eb; text-decoration:none; }
  a:hover { text-decoration:underline; }
  nav { display:flex; gap:12px; font-size:13px; margin-bottom:16px; }
  .dl-btn { color:white; padding:3px 10px; border-radius:4px; font-size:12px; text-decoration:none; }
  .dl-none { color:#d1d5db; }
  .recompose-btn { background:none; border:1px solid #6b7280; color:#374151; padding:3px 10px;
                   border-radius:4px; font-size:12px; cursor:pointer; }
  .recompose-btn:hover { background:#f3f4f6; }
  .recompose-ok  { color:#059669; font-size:12px; }
  .recompose-err { color:#dc2626; font-size:12px; }
</style>
</head>
<body>
<nav>
  <a href="/">← Voltar</a>
  <a href="/traces">Log de execuções</a>
  <a href="/admin" style="color:#6b7280">Admin</a>
</nav>
<h1>Relatórios gerados</h1>
<span class="muted">{{ total }} relatório(s) em /output — ordenados do mais recente para o mais antigo.</span>
<table>
  <thead>
    <tr>
      <th>Timestamp</th>
      <th>Tamanho</th>
      <th>Relatório</th>
      <th>Downloads</th>
      <th>Log</th>
    </tr>
  </thead>
  <tbody>
    {% if reports %}
      {% for r in reports %}
      <tr>
        <td style="font-size:13px;font-family:monospace">{{ r.ts_display }}</td>
        <td style="font-size:12px;color:#6b7280">{{ r.size_kb }} KB</td>
        <td>
          <a href="/output/{{ r.stem }}.html"
             class="dl-btn" style="background:#1e40af">&#128196; Ver relatório</a>
        </td>
        <td style="display:flex;gap:6px;flex-wrap:wrap">
          {% if r.has_json %}
            <a href="/output/{{ r.stem }}.json" download class="dl-btn" style="background:#1e40af">⬇ JSON</a>
          {% else %}
            <span class="dl-none">— JSON</span>
          {% endif %}
          {% if r.has_csv %}
            <a href="/output/{{ r.stem }}.csv" download class="dl-btn" style="background:#047857">⬇ CSV</a>
          {% else %}
            <span class="dl-none">— CSV</span>
          {% endif %}
          {% if r.has_md %}
            <a href="/output/{{ r.stem }}.md" download class="dl-btn" style="background:#6b7280">⬇ MD</a>
          {% else %}
            <span class="dl-none">— MD</span>
          {% endif %}
        </td>
        <td>
          {% if r.has_json %}
          <button class="recompose-btn" onclick="recompose('{{ r.stem }}', this)">↺ Recompor log</button>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    {% else %}
      <tr>
        <td colspan="4" style="text-align:center;padding:32px;color:#9ca3af">
          Nenhum relatório gerado ainda. Processe um CSV para começar.
        </td>
      </tr>
    {% endif %}
  </tbody>
</table>
{% raw %}
<script>
async function recompose(stem, btn) {
  btn.disabled = true;
  btn.textContent = '⏳';
  try {
    const r = await fetch('/traces/recompose?stem=' + encodeURIComponent(stem), {method: 'POST'});
    const d = await r.json();
    if (r.ok) {
      btn.outerHTML = '<span class="recompose-ok">✓ ' + d.recomposed + ' entradas</span>';
    } else {
      btn.disabled = false;
      btn.textContent = '↺ Recompor log';
      alert('Erro: ' + (d.detail || JSON.stringify(d)));
    }
  } catch(e) {
    btn.disabled = false;
    btn.textContent = '↺ Recompor log';
    alert('Falha na requisição: ' + e);
  }
}
</script>
{% endraw %}
</body>
</html>
