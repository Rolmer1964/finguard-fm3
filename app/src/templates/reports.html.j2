<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Relatórios — FinGuard</title>
<style>
  body { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
         max-width:1100px; margin:32px auto; padding:0 16px; color:#1f2937; background:#f9fafb; }
  h1 { margin-bottom:4px; }
  .muted { color:#6b7280; font-size:13px; margin-bottom:16px; display:block; }
  table { width:100%; border-collapse:collapse; background:white; border-radius:8px;
          overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.08); }
  th { background:#1e40af; color:white; padding:10px 12px; text-align:left;
       font-size:12px; text-transform:uppercase; letter-spacing:.04em; white-space:nowrap; }
  td { padding:10px 12px; border-bottom:1px solid #e5e7eb; vertical-align:middle; }
  tr:last-child td { border-bottom:none; }
  tr:hover td { background:#f0f9ff; }
  a { color:#2563eb; text-decoration:none; }
  a:hover { text-decoration:underline; }
  .dl-btn { color:white; padding:3px 10px; border-radius:4px; font-size:12px;
            text-decoration:none; white-space:nowrap; }
  .dl-none { color:#d1d5db; white-space:nowrap; }
  .recompose-btn { background:none; border:1px solid #6b7280; color:#374151; padding:3px 10px;
                   border-radius:4px; font-size:12px; cursor:pointer; white-space:nowrap; }
  .recompose-btn:hover { background:#f3f4f6; }
  .recompose-ok  { color:#059669; font-size:12px; white-space:nowrap; }
  .recompose-err { color:#dc2626; font-size:12px; }
  .del-btn { background:none; border:1px solid #fca5a5; color:#dc2626; padding:3px 10px;
             border-radius:4px; font-size:12px; cursor:pointer; white-space:nowrap; }
  .del-btn:hover { background:#fef2f2; border-color:#f87171; }
</style>
</head>
<body>
{% set active = 'reports' %}
{% include '_header.html.j2' %}
<h1>Relatórios gerados</h1>
<span class="muted">{{ total }} relatório(s) em /output — ordenados do mais recente para o mais antigo.</span>
<table>
  <thead>
    <tr>
      <th>Report ID</th>
      <th>Identificação</th>
      <th>Arquivo</th>
      <th>Tamanho</th>
      <th>Relatório</th>
      <th>Log</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {% if reports %}
      {% for r in reports %}
      <tr>
        <td style="font-size:13px;font-family:monospace;white-space:nowrap">{{ r.ts_display }}</td>
        <td style="font-size:13px;color:{% if r.label %}#1f2937{% else %}#9ca3af{% endif %}">
          {{ r.label if r.label else "—" }}
        </td>
        <td style="font-size:12px;color:{% if r.filename %}#374151{% else %}#9ca3af{% endif %};white-space:nowrap">
          {{ r.filename if r.filename else "—" }}
        </td>
        <td style="font-size:12px;color:#6b7280">{{ r.size_kb }} KB</td>
        <td>
          <a href="/report/{{ r.stem }}"
             class="dl-btn" style="background:#1e40af">&#128196; Ver relatório</a>
        </td>
        <td>
          {% if r.has_json %}
          <button class="recompose-btn" onclick="recompose('{{ r.stem }}', this)">↺ Recompor log</button>
          {% endif %}
        </td>
        <td>
          <button class="del-btn" onclick="deleteReport('{{ r.stem }}', this)">✕ Deletar</button>
        </td>
      </tr>
      {% endfor %}
    {% else %}
      <tr>
        <td colspan="7" style="text-align:center;padding:32px;color:#9ca3af">
          Nenhum relatório gerado ainda. Processe um CSV para começar.
        </td>
      </tr>
    {% endif %}
  </tbody>
</table>
{% raw %}
<script>
async function deleteReport(stem, btn) {
  if (!confirm('Deletar o relatório ' + stem + '?\nEsta ação não pode ser desfeita.')) return;
  btn.disabled = true;
  btn.textContent = '⏳';
  try {
    const r = await fetch('/report/' + encodeURIComponent(stem), {method: 'DELETE'});
    const d = await r.json();
    if (r.ok) {
      btn.closest('tr').remove();
    } else {
      btn.disabled = false;
      btn.textContent = '✕ Deletar';
      alert('Erro: ' + (d.detail || JSON.stringify(d)));
    }
  } catch(e) {
    btn.disabled = false;
    btn.textContent = '✕ Deletar';
    alert('Falha na requisição: ' + e);
  }
}

async function recompose(stem, btn) {
  btn.disabled = true;
  btn.textContent = '⏳';
  try {
    const r = await fetch('/traces/recompose?stem=' + encodeURIComponent(stem), {method: 'POST'});
    const d = await r.json();
    if (r.ok) {
      btn.outerHTML = '<span class="recompose-ok">✓ ' + d.recomposed + ' entradas</span>';
    } else {
      btn.disabled = false;
      btn.textContent = '↺ Recompor log';
      alert('Erro: ' + (d.detail || JSON.stringify(d)));
    }
  } catch(e) {
    btn.disabled = false;
    btn.textContent = '↺ Recompor log';
    alert('Falha na requisição: ' + e);
  }
}
</script>
{% endraw %}
</body>
</html>
