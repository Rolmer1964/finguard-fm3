<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Dados Decisórios — FinGuard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
{% include '_style.html.j2' %}
<style>
  .app .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .app .grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
  .app .kpi.green { color:#1f5c34; }
  .app .kpi.blue  { color:var(--bordo-700); }
  .app .kpi.orange{ color:var(--gold-dark); }
  .app .kpi.slate { color:#5c1330; }
  .app .kpi-sub   { font-size:12px; color:var(--muted); margin-top:4px; }
  .app .chart-wrap { position:relative; height:260px; }
  .app .chart-wrap-tall { position:relative; height:320px; }
  .app table.decisorio { margin-top:4px; box-shadow:none; }
  .app table.decisorio th, .app table.decisorio td { border:1px solid var(--border); }
  .app .badge { display:inline-block; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; }
  .app .b-red    { background:#f6d9de; color:#7a1a2b; }
  .app .b-orange { background:#f7e3d0; color:#8a4a12; }
  .app .b-yellow { background:#faf0cf; color:#7a5f0c; }
  .app .b-green  { background:#dcefe0; color:#1f5c34; }
  .app .b-blue   { background:var(--bordo-100); color:var(--bordo-800); }
  .app .b-gray   { background:#f3ebee; color:#5c1330; }
  .app .alert { padding:10px 14px; border-radius:6px; font-size:13px; margin-bottom:8px; display:flex; gap:10px; align-items:flex-start; }
  .app .alert-red    { background:#fdf0f2; border-left:3px solid var(--bordo-500); }
  .app .alert-yellow { background:#fffbeb; border-left:3px solid #f59e0b; }
  .app .matrix td { text-align:center; font-size:12px; font-weight:600; }
  .app .matrix th { text-align:center; font-size:11px; }
  .app .m-high  { background:#f6d9de; color:#7a1a2b; }
  .app .m-med   { background:#f7e3d0; color:#8a4a12; }
  .app .m-low   { background:#f0f9f2; color:#1f5c34; }
  .app .m-zero  { background:var(--bg); color:#c7b1b8; }
  .app .src-link { font-size:12px; color:var(--muted); text-align:right; margin-top:16px; }
  #loading { display:flex; align-items:center; gap:10px; padding:32px 0; color:var(--muted); font-size:14px; }
  .spinner { width:20px; height:20px; border:2px solid var(--border); border-top-color:var(--bordo-600);
             border-radius:50%; animation:spin .8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
  #error-box { display:none; padding:12px 16px; background:#f6d9de; color:#7a1a2b;
               border-radius:6px; font-size:13px; margin-top:12px; }
  #content { display:none; }
</style>
</head>
<body class="app">
{% set active = 'politica_decisoria' %}
{% include '_header.html.j2' %}
<div class="app-body">

<div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px">
  <div>
    <h1 style="margin-top:4px">Painel Decisório — POL-SAC-001</h1>
    <p class="muted" id="subtitle">Integração estrutural da política interna nos agentes · carregando…</p>
  </div>
  <button class="btn" style="margin-top:0;align-self:center" onclick="loadStats()">↺ Atualizar</button>
</div>

<div id="loading"><div class="spinner"></div> Carregando dados do log de execuções…</div>
<div id="error-box"></div>
<div id="content">

<!-- ── KPIs ──────────────────────────────────────────────────────────────────── -->
<div class="grid-4" style="margin-top:20px">
  <div class="card kpi-card" style="margin-top:0">
    <h3 style="margin:0 0 12px;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-family:inherit">Registros processados</h3>
    <div class="kpi blue v" id="kpi-processados">—</div>
    <div class="kpi-sub" id="kpi-processados-sub">—</div>
  </div>
  <div class="card kpi-card" style="margin-top:0">
    <h3 style="margin:0 0 12px;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-family:inherit">Latência média e2e</h3>
    <div class="kpi slate v" id="kpi-latencia">—</div>
    <div class="kpi-sub">ms total pipeline</div>
  </div>
  <div class="card kpi-card" style="margin-top:0">
    <h3 style="margin:0 0 12px;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-family:inherit">Canais monitorados</h3>
    <div class="kpi green v" id="kpi-canais">—</div>
    <div class="kpi-sub" id="kpi-canais-sub">—</div>
  </div>
  <div class="card kpi-card" style="margin-top:0">
    <h3 style="margin:0 0 12px;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-family:inherit">Áreas responsáveis</h3>
    <div class="kpi slate v" id="kpi-areas">—</div>
    <div class="kpi-sub">mapeadas pela política</div>
  </div>
</div>

<!-- ── Prazos + Produto→Área ─────────────────────────────────────────────────── -->
<div class="section-title">Distribuição de Prazos Derivados da Urgência</div>
<div class="grid-2">
  <div class="card" style="margin-top:0">
    <h3>Prazos de resposta (não-bloqueados)</h3>
    <div class="chart-wrap"><canvas id="chartPrazos"></canvas></div>
  </div>
  <div class="card" style="margin-top:0">
    <h3>Detalhamento por nível</h3>
    <table class="decisorio" id="tbl-prazos">
      <thead><tr><th>Prazo</th><th>Urgência</th><th>N</th><th>%</th></tr></thead>
      <tbody></tbody>
    </table>
    <p style="font-size:12px;color:var(--muted);margin-top:8px">
      Prazos derivados conforme §4 da POL-SAC-001: Crítica→4h, Alta→24h, Média→3 dias úteis, Baixa→5 dias úteis.
    </p>
  </div>
</div>

<div class="section-title">Mapeamento Produto → Área Responsável</div>
<div class="grid-2">
  <div class="card" style="margin-top:0">
    <h3>Encaminhamento por área (não-bloqueados)</h3>
    <div class="chart-wrap-tall"><canvas id="chartAreas"></canvas></div>
  </div>
  <div class="card" style="margin-top:0">
    <h3>Detalhamento</h3>
    <table class="decisorio" id="tbl-areas">
      <thead><tr><th>Área responsável</th><th>N</th><th>%</th></tr></thead>
      <tbody></tbody>
    </table>
    <p style="font-size:12px;color:var(--muted);margin-top:8px">
      "Área de Suporte Geral" é o fallback para <code>produto = Não Identificado</code>.
    </p>
  </div>
</div>

<!-- ── Canais ─────────────────────────────────────────────────────────────────── -->
<div class="section-title">Distribuição por Canal</div>
<div class="grid-2">
  <div class="card" style="margin-top:0">
    <h3>Volume e % Crítica por canal</h3>
    <div class="chart-wrap-tall"><canvas id="chartCanais"></canvas></div>
  </div>
  <div class="card" style="margin-top:0">
    <h3>Detalhamento e alinhamento com §4.3</h3>
    <table class="decisorio" id="tbl-canais">
      <thead><tr><th>Canal</th><th>Total</th><th>% Crítica</th></tr></thead>
      <tbody></tbody>
    </table>
    <div class="alert alert-red" style="margin-top:12px">
      <span>🔴</span>
      <div>Banco Central: §4.3 da POL-SAC-001 exige urgência CRÍTICA automática para qualquer reclamação desse canal.
      <strong>Override determinístico implementado.</strong></div>
    </div>
  </div>
</div>

<!-- ── Matrix Urgência × Risco ──────────────────────────────────────────────── -->
<div class="section-title">Cruzamento Urgência × Risco</div>
<div class="card" style="margin-top:0">
  <h3 id="matrix-title">Distribuição de registros (valores absolutos · % da linha entre parênteses)</h3>
  <table class="decisorio matrix" id="tbl-matrix">
    <thead>
      <tr>
        <th style="text-align:left">Urgência ↓ / Risco →</th>
        <th>Crítico</th><th>Alto</th><th>Médio</th><th>Baixo</th><th>Total</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
  <div class="alert alert-yellow" style="margin-top:12px">
    <span>⚠</span>
    <div><strong>Célula Baixa × Crítico</strong> — ataques de engenharia social capturados pelo Sonnet
    após passarem pelo Haiku com urgência Baixa. O Haiku vê texto aparentemente legítimo; o Sonnet detecta a
    intenção maliciosa e eleva para risco Crítico, citando §5 da POL-SAC-001 (proteção de dados · LGPD).
    Este padrão <code>Outros + Crítico</code> opera como segunda linha de defesa conforme design da ADR-001.</div>
  </div>
</div>

<!-- ── Urgência + Risco ────────────────────────────────────────────────────────── -->
<div class="section-title">Distribuição de Urgência e Risco</div>
<div class="grid-2">
  <div class="card" style="margin-top:0">
    <h3>Urgência (não-bloqueados)</h3>
    <div class="chart-wrap"><canvas id="chartUrgency"></canvas></div>
  </div>
  <div class="card" style="margin-top:0">
    <h3>Nível de risco (não-bloqueados)</h3>
    <div class="chart-wrap"><canvas id="chartRisk"></canvas></div>
  </div>
</div>

<!-- ── Anomalias ─────────────────────────────────────────────────────────────── -->
<div class="section-title">Anomalias Identificadas (POL-SAC-001)</div>
<div class="alert alert-red">
  <span style="font-size:16px">🔴</span>
  <div>
    <strong>CRÍTICA — Canal "Banco Central" não forçava urgência Crítica</strong><br>
    <span class="muted">§4.3 da POL-SAC-001 exige urgência CRÍTICA automática para qualquer reclamação via BC.
    <strong>Correção implementada</strong>: override determinístico em
    <code>consolidate()</code> — todos os registros BC passam a Crítica.</span>
  </div>
</div>
<div class="alert alert-yellow">
  <span style="font-size:16px">🟡</span>
  <div>
    <strong>MÉDIA — Urgência Baixa + Risco Crítico sem auto-escalação</strong><br>
    <span class="muted">Ataques capturados pela segunda linha apresentavam <code>urgência: Baixa</code> visível
    ao analista, conflitando com o risco Crítico.
    <strong>Correção implementada</strong>: escalação automática — risco Crítico garante urgência mínima Alta.</span>
  </div>
</div>
<div class="alert alert-yellow">
  <span style="font-size:16px">🟡</span>
  <div>
    <strong>BAIXA — Validação de produto contra lista permitida</strong><br>
    <span class="muted">Haiku confundiu categoria com produto em textos genéricos.
    <strong>Correção implementada</strong>: validação pós-triagem contra lista de produtos permitidos.</span>
  </div>
</div>

<!-- ── Recomendações ─────────────────────────────────────────────────────────── -->
<div class="section-title">Recomendações Priorizadas</div>
<div class="card" style="margin-top:0">
  <table class="decisorio">
    <thead><tr><th>#</th><th>Ação</th><th>Impacto</th><th>Esforço</th><th>Status</th></tr></thead>
    <tbody>
      <tr>
        <td>1</td>
        <td>Override determinístico urgência por canal (BC → Crítica)</td>
        <td><span class="badge b-red">Alto</span></td>
        <td>Baixo (10 linhas)</td>
        <td><span class="badge b-green">✓ Implementado</span></td>
      </tr>
      <tr>
        <td>2</td>
        <td>Escalação automática urgência quando risco &gt; urgência</td>
        <td><span class="badge b-orange">Médio</span></td>
        <td>Baixo (5 linhas)</td>
        <td><span class="badge b-green">✓ Implementado</span></td>
      </tr>
      <tr>
        <td>3</td>
        <td>Validação de produto contra lista permitida</td>
        <td><span class="badge b-green">Baixo</span></td>
        <td>Baixo (5 linhas)</td>
        <td><span class="badge b-green">✓ Implementado</span></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="src-link">
  Análise completa:
  <a href="/assets/presentation/analise_politica_pos_deploy.md" target="_blank">analise_politica_pos_deploy.md</a>
  · Relatório gerencial:
  <a href="/relatorio-tecnico" target="_blank">Rel. Técnico de Entrega</a>
  · Decisões arquiteturais:
  <a href="#" onclick="openAdrModal();return false;">ADR-001</a>
</div>

</div><!-- #content -->
</div><!-- app-body -->

<script>
const PRAZO_ORDER  = ['4 horas', '24 horas', '3 dias úteis', '5 dias úteis'];
const PRAZO_LABELS = ['4 horas (Crítica)', '24 horas (Alta)', '3 dias úteis (Média)', '5 dias úteis (Baixa)'];
const PRAZO_URGENCIA = {'4 horas':'Crítica','24 horas':'Alta','3 dias úteis':'Média','5 dias úteis':'Baixa'};
const URGENCY_COLORS = {'Crítica':'#b02c50','Alta':'#b8893f','Média':'#d4b23a','Baixa':'#3f8a5c'};
const RISK_COLORS    = {'Crítico':'#b02c50','Alto':'#b8893f','Médio':'#d4b23a','Baixo':'#3f8a5c'};
const AREA_COLORS    = ['#7a1a35','#93213f','#b02c50','#c94a6b','#e0899e','#b8893f','#8a6a2c','#551227'];

let charts = {};

function destroyChart(id) {
  if (charts[id]) { charts[id].destroy(); delete charts[id]; }
}

function pct(n, total) {
  return total ? (n / total * 100).toFixed(1) + '%' : '—';
}

function renderPrazos(prazos, processados) {
  const order = PRAZO_ORDER.filter(k => prazos[k] !== undefined);
  const data  = order.map(k => prazos[k] || 0);
  const total = data.reduce((a,b) => a+b, 0);

  destroyChart('chartPrazos');
  charts['chartPrazos'] = new Chart(document.getElementById('chartPrazos'), {
    type: 'doughnut',
    data: {
      labels: order.map(k => PRAZO_LABELS[PRAZO_ORDER.indexOf(k)] || k),
      datasets: [{ data, backgroundColor: order.map(k => URGENCY_COLORS[PRAZO_URGENCIA[k]] || '#94a3b8'), borderWidth:2, borderColor:'#fffdfd' }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins: {
        legend: { position:'bottom', labels:{font:{size:12}} },
        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.raw} (${pct(ctx.raw, total)})` } }
      }
    }
  });

  const tbody = document.querySelector('#tbl-prazos tbody');
  tbody.innerHTML = '';
  const classes = {'4 horas':'b-red','24 horas':'b-orange','3 dias úteis':'b-yellow','5 dias úteis':'b-green'};
  order.forEach(k => {
    const n = prazos[k] || 0;
    tbody.innerHTML += `<tr><td><span class="badge ${classes[k]||'b-gray'}">${k}</span></td>
      <td>${PRAZO_URGENCIA[k]||'—'}</td><td>${n}</td><td>${pct(n,total)}</td></tr>`;
  });
  tbody.innerHTML += `<tr style="font-weight:600"><td colspan="2">Total</td><td>${total}</td><td>100%</td></tr>`;
}

function renderAreas(areas, processados) {
  const sorted = Object.entries(areas).sort((a,b) => b[1]-a[1]);
  const labels = sorted.map(([k]) => k);
  const data   = sorted.map(([,v]) => v);
  const total  = data.reduce((a,b) => a+b, 0);

  destroyChart('chartAreas');
  charts['chartAreas'] = new Chart(document.getElementById('chartAreas'), {
    type:'bar',
    data: { labels, datasets:[{ label:'Registros', data, backgroundColor:labels.map((_,i)=>AREA_COLORS[i%AREA_COLORS.length]), borderRadius:4 }] },
    options: {
      indexAxis:'y', responsive:true, maintainAspectRatio:false,
      plugins: { legend:{display:false} },
      scales: { x:{grid:{color:'#f3ebee'}}, y:{ticks:{font:{size:11}}} }
    }
  });

  const tbody = document.querySelector('#tbl-areas tbody');
  tbody.innerHTML = '';
  sorted.forEach(([area, n]) => {
    tbody.innerHTML += `<tr><td>${area}</td><td><strong>${n}</strong></td><td>${pct(n, total)}</td></tr>`;
  });
}

function renderCanais(canais) {
  const sorted = Object.entries(canais).sort((a,b) => b[1].total - a[1].total);
  const labels  = sorted.map(([k]) => k);
  const totals  = sorted.map(([,v]) => v.total);
  const critica = sorted.map(([,v]) => v.critica);

  destroyChart('chartCanais');
  charts['chartCanais'] = new Chart(document.getElementById('chartCanais'), {
    type:'bar',
    data: {
      labels,
      datasets: [
        { label:'Total',   data:totals,  backgroundColor:'#e0b6c2', borderRadius:4 },
        { label:'Crítica', data:critica, backgroundColor:'#93213f', borderRadius:4 }
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins: {
        legend:{position:'bottom'},
        tooltip: { callbacks: { afterLabel: ctx => ctx.datasetIndex===1 ? ` ${pct(ctx.raw, totals[ctx.dataIndex])} do canal` : '' } }
      },
      scales: { x:{grid:{display:false}}, y:{grid:{color:'#f3ebee'}} }
    }
  });

  const tbody = document.querySelector('#tbl-canais tbody');
  tbody.innerHTML = '';
  sorted.forEach(([canal, v]) => {
    const pctCrit = pct(v.critica, v.total);
    tbody.innerHTML += `<tr><td>${canal}</td><td>${v.total}</td><td>${pctCrit}</td></tr>`;
  });
}

function renderMatrix(matrix, urgLevels, riskLevels, processados) {
  document.getElementById('matrix-title').textContent =
    `Distribuição de ${processados} registros (valores absolutos · % da linha entre parênteses)`;

  const URGENCY_BADGES = {
    'Crítica': 'b-red', 'Alta': 'b-orange', 'Média': 'b-yellow', 'Baixa': 'b-green'
  };

  function cellClass(n, rowTotal) {
    if (!n) return 'm-zero';
    const r = n / rowTotal;
    if (r >= 0.5) return 'm-high';
    if (r >= 0.2) return 'm-med';
    return 'm-low';
  }

  const tbody = document.querySelector('#tbl-matrix tbody');
  tbody.innerHTML = '';
  urgLevels.forEach(u => {
    const row = matrix[u] || {};
    const rowTotal = riskLevels.reduce((s, r) => s + (row[r] || 0), 0);
    let cells = riskLevels.map(r => {
      const n = row[r] || 0;
      const cls = (u === 'Baixa' && r === 'Crítico' && n > 0)
        ? 'm-high" style="border:2px solid #b02c50'
        : cellClass(n, rowTotal);
      return n
        ? `<td class="${cls}">${n}<br><small>(${pct(n, rowTotal)})</small></td>`
        : `<td class="m-zero">—</td>`;
    }).join('');
    const bc = URGENCY_BADGES[u] || 'b-gray';
    tbody.innerHTML += `<tr>
      <td style="text-align:left;font-weight:600"><span class="badge ${bc}">${u}</span> (${rowTotal})</td>
      ${cells}
      <td>${rowTotal}</td>
    </tr>`;
  });
}

function renderUrgencyRisk(urgency, risk, processados) {
  const urgSorted  = Object.entries(urgency).sort((a,b) => b[1]-a[1]);
  const riskSorted = Object.entries(risk).sort((a,b) => b[1]-a[1]);

  destroyChart('chartUrgency');
  charts['chartUrgency'] = new Chart(document.getElementById('chartUrgency'), {
    type:'doughnut',
    data: {
      labels: urgSorted.map(([k]) => k),
      datasets:[{ data:urgSorted.map(([,v])=>v),
        backgroundColor: urgSorted.map(([k]) => URGENCY_COLORS[k] || '#94a3b8'),
        borderWidth:2, borderColor:'#fffdfd' }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins: {
        legend:{position:'bottom', labels:{font:{size:12}}},
        tooltip:{ callbacks:{ label: ctx => ` ${ctx.label}: ${ctx.raw} (${pct(ctx.raw, processados)})` } }
      }
    }
  });

  destroyChart('chartRisk');
  charts['chartRisk'] = new Chart(document.getElementById('chartRisk'), {
    type:'doughnut',
    data: {
      labels: riskSorted.map(([k]) => k),
      datasets:[{ data:riskSorted.map(([,v])=>v),
        backgroundColor: riskSorted.map(([k]) => RISK_COLORS[k] || '#94a3b8'),
        borderWidth:2, borderColor:'#fffdfd' }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins: {
        legend:{position:'bottom', labels:{font:{size:12}}},
        tooltip:{ callbacks:{ label: ctx => ` ${ctx.label}: ${ctx.raw} (${pct(ctx.raw, processados)})` } }
      }
    }
  });
}

async function loadStats() {
  document.getElementById('loading').style.display = 'flex';
  document.getElementById('content').style.display = 'none';
  document.getElementById('error-box').style.display = 'none';

  try {
    const res = await fetch('/api/decisorio/stats');
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const s = await res.json();

    // KPIs
    document.getElementById('kpi-processados').textContent = s.processados.toLocaleString('pt-BR');
    document.getElementById('kpi-processados-sub').textContent = `de ${s.total} totais · ${s.bloqueados} bloqueados`;
    document.getElementById('kpi-latencia').textContent = s.avg_total_ms ? s.avg_total_ms.toLocaleString('pt-BR') : '—';
    document.getElementById('kpi-canais').textContent = Object.keys(s.canais).length;
    document.getElementById('kpi-canais-sub').textContent = Object.keys(s.canais).join(', ');
    document.getElementById('kpi-areas').textContent = Object.keys(s.areas).length;

    // Subtitle
    const agora = new Date().toLocaleString('pt-BR', {timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'});
    document.getElementById('subtitle').textContent =
      `Integração estrutural da política interna nos agentes · ${s.total} registros · atualizado às ${agora}`;

    renderPrazos(s.prazos, s.processados);
    renderAreas(s.areas, s.processados);
    renderCanais(s.canais);
    renderMatrix(s.matrix, s.urgency_levels, s.risk_levels, s.processados);
    renderUrgencyRisk(s.urgency, s.risk, s.processados);

    document.getElementById('loading').style.display = 'none';
    document.getElementById('content').style.display = 'block';
  } catch(e) {
    document.getElementById('loading').style.display = 'none';
    const eb = document.getElementById('error-box');
    eb.textContent = 'Erro ao carregar dados: ' + e.message;
    eb.style.display = 'block';
  }
}

loadStats();
</script>
</body>
</html>
